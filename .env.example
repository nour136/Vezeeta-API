# Copy this file to .env before running `docker compose up`.
# .env is gitignored - never commit it. This file (.env.example) IS committed,
# so the values below are throwaway dev-only defaults, not real secrets.

# SQL Server 'sa' password. Must satisfy SQL Server's complexity policy
# (8+ chars, upper + lower + digit + symbol) or the container will fail to start.
SQL_SA_PASSWORD=YourStrong!Passw0rd

# JWT signing key. This dev value is fine for local docker compose use.
# Generate your own for anything beyond local dev, e.g.:
#   openssl rand -base64 32
JWT_KEY=lNpKJrZMeoM5nZv3EuMsh1ZFSHc+F387j1xbhcaFvjM=
JWT_ISSUER=SecureApi
JWT_AUDIENCE=SecureApiUser

# Default Admin account, bootstrapped once on first run (see Program.cs ->
# SeedDefaultAdminAsync). Change these before running against anything real.
ADMIN_EMAIL=admin@vezeeta.local
ADMIN_PASSWORD=Admin123!
